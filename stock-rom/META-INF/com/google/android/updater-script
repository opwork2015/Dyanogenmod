	abort("This package is for \"j5nlte\" devices; this is a \"" + getprop("ro.product.device") + "\"."););
unmount("/system");
ui_print(" ");
ui_print(" ");
ui_print("Stock ROM Advanced Installer");
ui_print("Built with SuperR's Kitchen");
ui_print("Credits");
ui_print("@SuperR. for his nice kitchen");
